# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file — it is already listed in .gitignore.

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace-with-your-influxdb-token
INFLUX_ORG=Unitn
INFLUX_BUCKET=access_control

# --- MQTT ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=access_control_backend

# --- QR / auth behaviour ---
TEMP_QR_LIFETIME_SECONDS=15
MAX_AUTH_ATTEMPTS=3
AUTH_LOCKOUT_MINUTES=10

# --- Secrets ---
# MASTER_SECRET signs the QR payloads (HMAC). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=replace-with-a-long-random-string

# --- Telegram bot (optional — leave blank to disable notifications) ---
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# --- Storage locations ---
QR_OUTPUT_DIR=./temp_qr
SNAPSHOT_DIR=./snapshots

# --- Door lock (optional hardware actuation) ---
# Leave DOOR_LOCK_ENABLED=false until a relay is actually wired to the pin below.
DOOR_LOCK_ENABLED=false
DOOR_LOCK_GPIO_PIN=17
DOOR_UNLOCK_SECONDS=5

# --- Web management UI ---
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=5000
